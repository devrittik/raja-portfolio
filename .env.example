# ---------------------------------------------------------------------------
# SITE
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ISR revalidation window for all Notion-backed data (seconds)
REVALIDATE_SECONDS=3600

# Secret used by POST /api/revalidate?secret=... for on-demand ISR
REVALIDATE_SECRET=change-me

# ---------------------------------------------------------------------------
# NOTION CMS (optional — without these the site runs on bundled showcase content)
# ---------------------------------------------------------------------------
# 1. Create an integration at https://www.notion.so/my-integrations
# 2. Share your root Notion page (containing all content databases) with it
NOTION_TOKEN=

# Optional: pin database IDs explicitly. If omitted, databases are
# auto-discovered by their title (e.g. a database named "Projects").
# NOTION_DB_PROJECTS=
# NOTION_DB_SERVICES=
# NOTION_DB_BLOG=
# NOTION_DB_TESTIMONIALS=
# NOTION_DB_EXPERIENCE=
# NOTION_DB_EDUCATION=
# NOTION_DB_SKILLS=
# NOTION_DB_CERTIFICATIONS=
# NOTION_DB_AWARDS=
# NOTION_DB_RESEARCH=
# NOTION_DB_FAQS=
# NOTION_DB_GALLERY=
# NOTION_DB_HOME=
# NOTION_DB_ABOUT=
# NOTION_DB_SITE_SETTINGS=
# NOTION_DB_SEO=
# NOTION_DB_NAVIGATION=
# NOTION_DB_FOOTER=
# NOTION_DB_SOCIAL_LINKS=

# ---------------------------------------------------------------------------
# CONTACT FORM (optional — without Resend the form validates and logs only)
# ---------------------------------------------------------------------------
RESEND_API_KEY=
CONTACT_FROM="Portfolio <onboarding@resend.dev>"
CONTACT_TO=you@example.com

# ---------------------------------------------------------------------------
# ANALYTICS (loaded only after cookie consent)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CLARITY_ID=
